# Docker build context exclusions for the ROOT context.
#
# The laravel image is built with the repository root as context, because
# infrastructure/docker/laravel.Dockerfile COPYs `application/...`; the
# application/ entries below are what that build actually needs excluded.
# fastapi/celery are built with the narrower `./ai-engine` context and use
# ai-engine/.dockerignore instead.
.git/
.github/
docs/
tests/
backups/
*.md
.env
.env.example
.gitignore
grafana-data/
pgdata/
datasets/
models/
data/

# Laravel build. The image runs `composer install` and builds its own Vite
# assets, so host copies of vendor/, node_modules/ and public/build must stay
# out of the root context.
application/vendor/
application/node_modules/
application/public/build/
application/public/hot
application/public/storage
application/storage/logs/*
application/storage/framework/cache/*
application/storage/framework/sessions/*
application/storage/framework/views/*
application/bootstrap/cache/*.php
application/.env
application/.env.backup
application/.env.production
application/.phpunit.cache/
application/.phpunit.result.cache
application/database/*.sqlite

# Python build
ai-engine/.env
ai-engine/.venv/
ai-engine/venv/
ai-engine/__pycache__/
ai-engine/.pytest_cache/
ai-engine/.ruff_cache/
ai-engine/htmlcov/
ai-engine/dev.db
