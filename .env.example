# =====================================================================
# AIDataPlatform — .env.example (root: the Docker Compose stack)
# ---------------------------------------------------------------------
# cp .env.example .env      (Linux, macOS, Git Bash)
# copy .env.example .env    (Windows PowerShell / cmd)
#
# This file is read by `docker compose` and interpolated into the
# containers. NEVER commit .env.
#
# Every variable below is grouped by the service that consumes it.
# Before any real deploy, change the values marked [CHANGE]:
#   POSTGRES_PASSWORD, SERVICE_API_KEY, SERVICE_API_KEY_HEADER,
#   APP_KEY, GRAFANA_ADMIN_PASSWORD, LLM_API_KEY / OPENROUTER_API_KEY
#
# How values reach each container:
#   laravel  - compose injects the "Laravel" group below; the container also
#             bind-mounts ./application, so application/.env still supplies
#             the keys compose does not inject (AI_ENGINE_*_TIMEOUT, ...).
#             When a key exists in both places, compose wins.
#   fastapi  - compose ASSEMBLES DATABASE_URL, SYNC_DATABASE_URL, REDIS_URL,
#             CELERY_BROKER_URL and CELERY_RESULT_BACKEND from the parts
#             below, so do not set the full URLs here.
# =====================================================================


# ---------- App ----------
APP_NAME=AIDataPlatform
# The engine only accepts demo|dev|staging|prod. Any other value (for
# example "production", compose's own default) is silently rewritten to
# "dev", which turns off service-key enforcement in the engine.
APP_ENV=prod
APP_DEBUG=false
APP_URL=http://localhost
# [CHANGE] base64 key, generate with: php artisan key:generate --show
# Empty = every request fails with "No application encryption key".
APP_KEY=
# Container timezone for every service.
TZ=Asia/Jakarta


# ---------- Database (Postgres + pgvector) ----------
POSTGRES_DB=aidata
POSTGRES_USER=aidata
# [CHANGE] strong random password. It is baked into the pgdata volume on
# first boot, so changing it later requires docker compose down -v.
POSTGRES_PASSWORD=changeme-local-dev-only


# ---------- Redis (cache, session, queue, Celery broker) ----------
# Leave empty for local work. If you set it, the `redis` healthcheck in
# docker-compose.yml (`redis-cli ping`, no -a) fails, laravel and fastapi
# stay in "waiting for dependency" forever, and the stack never boots.
REDIS_PASSWORD=
# Redis database used by the Laravel cache/session/queue.
REDIS_DB=0


# ---------- Laravel ----------
# Engine base URL. http://fastapi:8000 under Compose; use
# http://127.0.0.1:8001 when running Laravel without Docker.
AI_ENGINE_URL=http://fastapi:8000
# [CHANGE] shared secret between Laravel and the engine. Compose injects
# this one value into both services, so they always agree. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=change-me-generate-a-real-service-key
# [CHANGE TOGETHER WITH THE ENGINE] Header Laravel sends the key in.
# The engine hardcodes `X-Service-Key` (ai-engine/app/core/security.py) and
# does NOT read this variable, so renaming it here alone makes every engine
# call fail: 401 from the engine, surfaced to the browser as 502.
SERVICE_API_KEY_HEADER=X-Service-Key
# Per-call timeouts in seconds. Compose does not inject these, so inside
# the container they are read from application/.env - keep both files in sync.
AI_ENGINE_CONNECT_TIMEOUT=5
AI_ENGINE_TIMEOUT=60
AI_ENGINE_LLM_TIMEOUT=120
AI_ENGINE_UPLOAD_TIMEOUT=300
# Disk Laravel stores uploaded datasets on (storage/app).
FILESYSTEM_DISK=local


# ---------- AI engine / Celery ----------
# Worker parallelism and the queue list celery-worker subscribes to.
# `ingestion` is the queue the engine routes import_file to
# (app/workers/celery_app.py task_routes); drop it and imports are enqueued
# to a queue nobody consumes.
CELERY_CONCURRENCY=4
CELERY_QUEUES=default,ingestion,imports,quality,ml,agent,rag
# Beat scheduler class. `redbeat` is NOT in ai-engine/requirements.txt, so
# redbeat.RedBeatScheduler makes celery-beat crash-loop with "Cannot load
# scheduler class". Add the package to the image before switching to it.
CELERY_BEAT_SCHEDULER=celery.beat.PersistentScheduler
# Redis database numbers compose uses to build CELERY_BROKER_URL and
# CELERY_RESULT_BACKEND. The engine itself takes broker and result backend
# from REDIS_URL (REDIS_DB), so these two only take effect once the engine
# reads them.
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2


# ---------- LLM / AI ----------
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# [CHANGE] provider API key. Assistant, RAG and reports fail without it;
# ingestion, analytics and the rest of the UI keep working.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
# Used when LLM_PROVIDER=openrouter; falls back to LLM_API_KEY when empty.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Embedding model id. Note: the engine reads LLM_EMBEDDING_MODEL, not this
# name, so changing it has no effect until docker-compose.yml is fixed.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ---------- Monitoring ----------
# Metric retention window.
PROMETHEUS_RETENTION=15d
# Global scrape interval, read by infrastructure/monitoring/prometheus.yml.
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
# [CHANGE]
GRAFANA_ADMIN_PASSWORD=admin


# ---------- Uploads & quality ----------
# Hard cap Laravel enforces on uploads. Keep it at or below
# `client_max_body_size` in infrastructure/nginx/default.conf (500M) and
# PHP's upload_max_filesize / post_max_size.
MAX_UPLOAD_MB=500
# Minimum quality score to promote a dataset from staging to the warehouse.
# Below the threshold the dataset is quarantined instead of committed.
QUALITY_THRESHOLD=0.75


# ---------- Paths & ports ----------
# Docker network name and the prefix for every named volume.
NETWORK_NAME=aidata-appnet
VOLUME_PREFIX=aidata
# Host ports published by Compose. Change these if something already owns them.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LARAVEL_PORT=8080
FASTAPI_PORT=8001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379


# ---------- Backup (host script: infrastructure/scripts/backup.sh) ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional S3 offload; the script skips the upload while the bucket is empty.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aidata/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
