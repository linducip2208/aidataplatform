# =====================================================================
# AIDataPlatform — .env.example (root: the Docker Compose stack)
# ---------------------------------------------------------------------
#   cp .env.example .env      (Linux, macOS, Git Bash)
#   copy .env.example .env    (Windows PowerShell / cmd)
#
# This file is read by `docker compose` and by the host-side scripts in
# infrastructure/scripts/. It is NOT read inside a container. NEVER commit
# .env.
#
# Before booting for the first time, fill in the four [REQUIRED] values in
# section 1. Everything else already has a value that works locally.
#
# How a value reaches a container:
#   compose only forwards the names it lists under a service's `environment:`
#   (docker-compose.yml). Laravel additionally bind-mounts ./application, so
#   application/.env supplies the keys compose does not forward
#   (AI_ENGINE_*_TIMEOUT, AI_ENGINE_URL overrides, ...). When a key exists in
#   both places, compose wins. The engine bind-mounts ./ai-engine, so
#   ai-engine/.env does the same for it.
#
# Every name below is interpolated by docker-compose.yml or expanded by a host
# script. `sh tests/verify-env.sh` proves that claim mechanically: it fails the
# build on a name compose forwards that nothing reads, a name code reads that
# nothing forwards, and a [REQUIRED] name that is missing or unmarked.
# =====================================================================


# ---------- 1. [REQUIRED] fill these in before the first boot ----------
# Nothing else in this file is a secret, and nothing else blocks startup.

# Laravel's encryption key. Empty = every request fails with
# "No application encryption key", and infrastructure/docker/laravel-entrypoint.sh
# refuses to start the container at all. Compose forwards this one value into
# the laravel, laravel-queue and laravel-schedule containers.
#   php artisan key:generate --show
# [REQUIRED]
APP_KEY=

# Shared secret between Laravel and the AI engine. Compose injects this one
# value into laravel AND fastapi AND both celery services, so the two sides
# always agree. A placeholder value counts as "not configured":
# ai-engine/app/core/security.py::configured_service_key() rejects it, and every
# engine-backed page returns 502.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# [REQUIRED]
SERVICE_API_KEY=change-me-generate-a-real-service-key

# Password for the Postgres role. It is baked into the pgdata volume on first
# boot, so changing it later needs `docker compose down -v`. The value below is
# a safe local default that lets `cp .env.example .env && docker compose up`
# work; replace it before the database is reachable from anywhere but localhost.
# [REQUIRED]
POSTGRES_PASSWORD=changeme-local-dev-only

# Grafana is published on GRAFANA_PORT with no other access control.
# [REQUIRED]
GRAFANA_ADMIN_PASSWORD=admin


# ---------- 2. App ----------
APP_NAME=AIDataPlatform
# The engine accepts dev|demo|local|test|staging|stage|prod|production
# (ALLOWED_APP_ENVS in ai-engine/app/core/config.py) and RAISES on anything
# else, so a typo here stops the engine instead of silently demoting it to dev.
APP_ENV=prod
APP_DEBUG=false
APP_URL=http://localhost


# ---------- 3. Database (Postgres + pgvector) ----------
POSTGRES_DB=aidata
POSTGRES_USER=aidata
# POSTGRES_PASSWORD is [REQUIRED], section 1.


# ---------- 4. Redis (cache, session, queue, Celery broker) ----------
# Leave empty for local work. Set it and it is used by redis-server, by the
# Redis URLs compose assembles, and by the Redis healthcheck (which
# authenticates, so an authenticated install still reports healthy).
REDIS_PASSWORD=
# Database indexes. config/database.php reads REDIS_DB for the default
# connection and REDIS_CACHE_DB for the cache store; compose injects both, so
# these cannot be left to application/.env.
REDIS_DB=0
REDIS_CACHE_DB=1


# ---------- 5. Laravel ----------
# Engine base URL. http://fastapi:8000 under Compose; use
# http://127.0.0.1:8001 when running Laravel without Docker.
AI_ENGINE_URL=http://fastapi:8000
# SERVICE_API_KEY is [REQUIRED], section 1.
# Header Laravel sends the key in. Both sides resolve it from this one
# variable: application/config/ai_engine.php and
# ai-engine/app/core/config.py::service_api_key_header (via
# security.py::resolve_service_key_header). Compose injects it into laravel
# and into fastapi/celery, so the two cannot drift apart.
# Leave it at X-Service-Key unless you change it here AND nowhere else.
SERVICE_API_KEY_HEADER=X-Service-Key
# Per-call timeouts in seconds. Compose does NOT forward these, so inside the
# container they are read from application/.env — keep both files in sync.
AI_ENGINE_CONNECT_TIMEOUT=5
AI_ENGINE_TIMEOUT=60
AI_ENGINE_LLM_TIMEOUT=120
AI_ENGINE_UPLOAD_TIMEOUT=300
# Disk Laravel stores uploaded datasets on (storage/app).
FILESYSTEM_DISK=local
# php artisan serve forks this many workers, but only when the value is in the
# process environment. laravel-entrypoint.sh exports it; a value that lives only
# in application/.env is never seen by the CLI server.
PHP_CLI_SERVER_WORKERS=4
# Run `artisan migrate --force` on boot. laravel, laravel-queue and
# laravel-schedule share one environment anchor, and only the `laravel` service
# runs the entrypoint, so this is inert for the other two.
# AI-engine's Alembic counterpart: ai-engine/docker-entrypoint.sh reads the same
# two names (compose sets AUTO_MIGRATE=false explicitly on celery-worker and
# celery-beat so only fastapi migrates).
AUTO_MIGRATE=true
AUTO_MIGRATE_STRICT=false


# ---------- 6. AI engine / Celery ----------
# Worker parallelism, and the queue list celery-worker subscribes to.
# `default` must be in the list or a task dispatched without an explicit queue
# is never consumed (celery_app.py sets task_default_queue="default").
CELERY_CONCURRENCY=4
CELERY_QUEUES=default,imports,quality,ml,agent,rag
# Beat scheduler class. `redbeat` is NOT in ai-engine/requirements.txt, so
# redbeat.RedBeatScheduler crash-loops celery-beat with
# "Cannot load scheduler class". Add the package before switching to it.
CELERY_BEAT_SCHEDULER=celery.beat.PersistentScheduler
# Redis database numbers compose assembles CELERY_BROKER_URL and
# CELERY_RESULT_BACKEND from. Do not set the URLs themselves here.
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2


# ---------- 7. LLM / AI ----------
# Provider selects which credentials are used (app/core/config.py):
#   openrouter -> OPENROUTER_BASE_URL, then OPENROUTER_API_KEY or LLM_API_KEY
#   anything else -> LLM_BASE_URL, then LLM_API_KEY or OPENAI_API_KEY
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# Provider API key. Assistant, RAG and narrative reports fail without it;
# ingestion, analytics, ML training and the rest of the UI keep working.
# Optional — leaving it empty is a supported configuration.
LLM_API_KEY=
# The ONLY model id the engine reads (app/ai/llm.py uses settings.llm_model for
# both completions and embeddings unless a request overrides it). There is no
# per-provider model variable: an OPENROUTER_MODEL key is forwarded to the
# container and ignored.
LLM_MODEL=anthropic/claude-3.5-sonnet
# Embedding model id. This is the engine's canonical name
# (ai-engine/app/core/config.py:114). The deprecated alias is EMBED_MODEL; if
# this line is renamed back to it, compose no longer forwards it and the engine
# silently falls back to text-embedding-3-small.
LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ---------- 8. Monitoring ----------
# Retention window. Applied through the prometheus command line; the scrape
# interval in infrastructure/monitoring/prometheus.yml is a LITERAL, because
# Prometheus performs no shell substitution in its config file.
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD is [REQUIRED], section 1.


# ---------- 9. Uploads & quality ----------
# One variable, two consumers: application/config/ai_engine.php validates
# incoming uploads against it and ai-engine/app/core/config.py refuses files
# larger than it. Keep it at or below `client_max_body_size` in
# infrastructure/nginx/default.conf (500M) and PHP's upload_max_filesize /
# post_max_size. Raising it raises the PHP and engine limits only — nginx holds
# a literal, so edit that file too.
MAX_UPLOAD_MB=500
# Minimum quality score to promote a dataset from staging to the warehouse.
# Below it the dataset is quarantined instead of committed. One variable, two
# consumers: application/config/ai_engine.php and the engine's
# quality_min_score (ai-engine/app/core/config.py:138).
QUALITY_THRESHOLD=0.75


# ---------- 10. Paths & ports ----------
# Docker network name and the prefix for every named volume.
NETWORK_NAME=aidata-appnet
VOLUME_PREFIX=aidata
# Host ports published by Compose. Change these if something already owns them.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LARAVEL_PORT=8080
FASTAPI_PORT=8001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379


# ---------- 11. Backup (host script: infrastructure/scripts/backup.sh) ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional S3 offload; the script skips the upload while the bucket is empty.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aidata/
# Read by the `aws` CLI the script shells out to, and by
# application/config/{services,filesystems}.php for the S3 disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1


# --- devops (AGENT 9: infra keys only; append below, never reorder above) ---
# Seconds each healthcheck probe waits before giving up. Read by
# infrastructure/scripts/healthcheck.sh as PROBE_TIMEOUT (the .ps1 twin uses a
# fixed 15 s). Raise on a slow host; the compose `healthcheck:` intervals keep
# their own values in docker-compose.yml and are unaffected.
PROBE_TIMEOUT=15
