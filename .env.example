# =====================================================================
# AIDataPlatform — .env.example
# Copy:  cp .env.example .env   (Linux) / copy .env.example .env (Windows)
# Then generate secrets: see hints below. NEVER commit real .env.
# =====================================================================

# ---------- App ----------
APP_NAME=AIDataPlatform
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=
# Generate: php artisan key:generate  (Laravel) — base64:xxx
APP_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
APP_LOCALE=en

# ---------- Network / ports ----------
NETWORK_NAME=aidata-appnet
VOLUME_PREFIX=aidata
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LARAVEL_PORT=8080
FASTAPI_PORT=8001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Laravel ----------
LARAVEL_HOST=laravel
LARAVEL_INTERNAL_PORT=8000
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Service-to-service ----------
AI_ENGINE_URL=http://fastapi:8000
SERVICE_API_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY_HEADER=X-Service-Key
INTERNAL_TOKEN_TTL=3600

# ---------- Database (Postgres + pgvector) ----------
POSTGRES_DB=aidata
POSTGRES_USER=aidata
POSTGRES_PASSWORD=changeme-please-rotate
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aidata
DB_USERNAME=aidata
DB_PASSWORD=changeme-please-rotate
DB_SCHEMA=public
DB_SSLMODE=prefer

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLIENT=phpredis

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_RESULT_DB=2
CELERY_CONCURRENCY=4
CELERY_QUEUES=default,imports,quality,ml,agent,rag
CELERY_BEAT_SCHEDULER=redbeat.RedBeatScheduler
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# ---------- LLM / AI ----------
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
RAG_TOP_K=8
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# OpenRouter (mirrors LLM_* when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=AIDataPlatform

# ---------- Ingestion / quality / ML ----------
MAX_UPLOAD_MB=500
MAX_UPLOAD_BYTES=524288000
ALLOWED_EXTENSIONS=csv,xlsx,xls,parquet,json,zip
QUALITY_THRESHOLD=0.75
QUALITY_FAIL_ACTION=quarantine
ML_DEFAULT_N_SPLITS=5
ML_MAX_TRAIN_ROWS=500000
ML_ARTIFACT_DIR=/app/data/models
DATASET_DIR=/app/data/datasets
MODEL_REGISTRY_DIR=/app/data/models/registry

# ---------- Observability ----------
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-change-me
METRICS_ENABLED=true

# ---------- PgAdmin (optional, dev only) ----------
PGADMIN_ENABLED=false
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin-change-me

# ---------- Mail (optional) ----------
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=AIDataPlatform

# ---------- Backup ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aidata/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
