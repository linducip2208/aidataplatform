# =====================================================================
# AIDataPlatform — ai-engine/.env.example
# ---------------------------------------------------------------------
#   cp ai-engine/.env.example ai-engine/.env
#
# Read by the engine itself, not by docker compose. pydantic-settings loads
# this file (app/core/config.py, env_file=".env") as the FALLBACK for every
# field of the Settings object; anything docker-compose.yml injects into the
# `fastapi` / `celery-worker` / `celery-beat` services wins over what is here.
# The container bind-mounts ./ai-engine over /code, so this file is present at
# runtime and is the fallback for every name compose does not forward.
#
# Names are the engine's. Where an older name is still accepted it is listed
# under its section as a comment; app/core/config.py logs a deprecation
# warning when the old name is the one that supplied the value.
#
# `sh tests/verify-env.sh` checks that every name below is read by the code.
# =====================================================================


# ---------- 1. [REQUIRED] ----------
# Shared secret with Laravel. A placeholder is treated as "not configured"
# (security.py::configured_service_key), so every engine-backed page returns
# 502 until this is a real value. Under Compose the root .env wins and this
# file is only the fallback.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# [REQUIRED]
SERVICE_API_KEY=change-me-service-key

# Signing key for the engine's own JWTs. Also a placeholder here means "not
# configured": _configured_jwt_secret() returns "" and token minting and
# verification fail. Under Compose nothing forwards this, so this file is the
# only place it can be set for a container run.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# [REQUIRED]
JWT_SECRET=change-me-jwt-secret


# ---------- 2. Runtime ----------
# One of dev|demo|local|test|staging|stage|prod|production. Anything else makes
# Settings raise at import (config.py:151), it does NOT fall back to dev.
# Laravel's own spelling (`production`) is accepted for compatibility.
APP_ENV=dev
APP_NAME=ai-engine
LOG_LEVEL=INFO
# Read by app/workers/celery_app.py for the Celery timezone. Compose does not
# forward TZ, so this file is the only place it is set; the containers
# therefore run in this zone.
TZ=Asia/Jakarta
# The engine's /health reports app_name, and app/main.py configures logging
# from log_level. Both are cosmetic.


# ---------- 3. Service API ----------
# The bind address and port the Settings object carries. INERT as far as the
# container is concerned: ai-engine/Dockerfile line 29 hardcodes
# `uvicorn app.main:app --host 0.0.0.0 --port 8000`, and no code reads these
# fields. Changing them does NOT move the port. To move it, change the
# Dockerfile CMD (and FASTAPI_PORT in the root .env for the published port).
API_HOST=0.0.0.0
API_PORT=8000
# Header Laravel sends SERVICE_API_KEY in. Both sides must agree or every
# engine call 401s, which Laravel surfaces as 502. application/config/
# ai_engine.php reads the same variable; under Compose it is injected into
# fastapi from the root .env, so both containers see one value.
SERVICE_API_KEY_HEADER=X-Service-Key
# Per-minute request ceiling, applied per credential fingerprint and per path
# by the middleware in app/main.py.
RATE_LIMIT_PER_MINUTE=120
# Only used when the engine mints or verifies a Bearer token. The Laravel side
# authenticates with the service key, so these three are for callers that hold
# a platform JWT.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# ---------- 4. Database ----------
# DATABASE_URL is the async URL docker-compose.yml assembles; the engine is
# synchronous, so config.py:184 rewrites an async driver to its sync
# equivalent, and SYNC_DATABASE_URL wins outright when it is set.
# alembic/env.py::get_url uses the same precedence.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidataplatform
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidataplatform
# Cache, health probe and Celery fallback broker.
REDIS_URL=redis://localhost:6379/0
# Under Compose both URLs below are assembled from CELERY_BROKER_DB and
# CELERY_RESULT_DB in the root .env and injected, so they win. Set them here
# only for a local, non-Docker Celery run.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# ---------- 5. LLM ----------
# LLM_PROVIDER picks the credentials (config.py::effective_llm_base_url /
# effective_llm_api_key):
#   openrouter -> OPENROUTER_BASE_URL + OPENROUTER_API_KEY (or LLM_API_KEY)
#   anything else -> LLM_BASE_URL + LLM_API_KEY (or OPENAI_API_KEY)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# Empty is a supported configuration: ingestion, analytics and ML keep working,
# the assistant / RAG / narrative reports do not.
LLM_API_KEY=
# The only model id the engine reads (app/ai/llm.py:80). There is no
# per-provider model variable.
LLM_MODEL=gpt-4o-mini
# Embedding model id. CANONICAL name, and the one docker-compose.yml forwards.
# The deprecated alias EMBED_MODEL is still accepted by config.py:57 and logs a
# deprecation warning, but nothing in this tree uses it any more.
LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# OpenRouter-compatible.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OpenAI-compatible.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=


# ---------- 6. Storage, models, uploads ----------
# Uploads land in STORAGE_PATH (imports.py, mapper.py), model artefacts in
# MODEL_PATH (ml/registry.py). get_settings() creates both on import.
# Under Compose both are the datasets-data / models-cache named volumes
# mounted at /code/data/... and the injected values win.
STORAGE_PATH=./datasets
MODEL_PATH=./models
# Hard cap on a single upload, enforced in ingestion/validator.py. The SAME
# variable caps it in Laravel (application/config/ai_engine.php reads
# MAX_UPLOAD_MB), so one number bounds the whole path.
# Deprecated alias: UPLOAD_MAX_MB (config.py:55). Renaming this line without
# renaming the compose key makes it inert.
MAX_UPLOAD_MB=200
# Rows per pandas chunk (ingestion/reader.py, preview.py).
CHUNK_ROWS=20000
# Quality gate: a dataset scoring below this is quarantined instead of
# committed (ingestion/quality.py, ingestion/etl.py). The SAME variable is
# read by application/config/ai_engine.php, and compose forwards
# QUALITY_THRESHOLD to laravel, fastapi and celery-worker.
# Deprecated alias: QUALITY_MIN_SCORE (config.py:56).
QUALITY_THRESHOLD=0.6


# ---------- 7. Observability & docs ----------
# Browser origins allowed to call the engine directly. Server-to-server calls
# from Laravel carry no Origin header and are unaffected.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Prometheus scrape target. /metrics is registered unauthenticated, so keep
# this true only while the engine stays on the private compose network.
METRICS_ENABLED=true
# When false, /metrics answers 404 to any peer that is not a container on the
# compose network. Leave it false.
METRICS_ALLOW_PUBLIC=false
# Serves /docs, /redoc and /openapi.json. Set false to close them.
DOCS_ENABLED=true
# Alert delivery webhook (app/alerts/notifiers.py, read with os.environ rather
# than through Settings). Empty or unset = alerts are recorded but not
# delivered, and the notifier says so.
ALERT_WEBHOOK_URL=


# ---------- 8. Migrations (ai-engine/docker-entrypoint.sh) ----------
# Skips `alembic upgrade head` on container start. Compose sets this to false
# explicitly on celery-worker and celery-beat, so only fastapi migrates.
AUTO_MIGRATE=true
# Aborts startup on a failed migration instead of warning and starting anyway.
AUTO_MIGRATE_STRICT=false
# Host/port probed before migrations run (the compose service name is
# "postgres"). The service is healthy before fastapi starts, so the probe
# normally returns immediately.
PGHOST_FOR_MIGRATION=postgres
PGPORT_FOR_MIGRATION=5432
# TCP probe budget: PG_WAIT_ATTEMPTS x PG_WAIT_INTERVAL seconds (~60 x 2s).
PG_WAIT_ATTEMPTS=60
PG_WAIT_INTERVAL=2
# Container working directory (the image WORKDIR). The compose bind mount and
# the STORAGE_PATH/MODEL_PATH above are all relative to it, so it is not
# operator-tunable: compose injects the literal /code and this file must agree.
APP_DIR=/code
