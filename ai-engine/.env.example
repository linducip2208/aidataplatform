# --- Environment ---
APP_ENV=dev
APP_NAME=ai-engine
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
SERVICE_API_KEY=change-me-service-key
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidataplatform
# Sync URL used by Alembic (docker-compose sets this; falls back to DATABASE_URL
# with postgresql+asyncpg:// rewritten to postgresql+psycopg2://)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidataplatform
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# OpenRouter-compatible (set LLM_PROVIDER=openrouter to use)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OpenAI-compatible alias
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Storage / Models ---
STORAGE_PATH=./datasets
MODEL_PATH=./models
UPLOAD_MAX_MB=200
CHUNK_ROWS=20000

# --- Quality gates ---
QUALITY_MIN_SCORE=0.6

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Migrations (docker-entrypoint.sh) ---
# AUTO_MIGRATE=false skips `alembic upgrade head` on container start
AUTO_MIGRATE=true
# AUTO_MIGRATE_STRICT=true aborts startup on a failed migration instead of warning
AUTO_MIGRATE_STRICT=false
# Host/port probed before migrations run (docker-compose service name is "postgres")
PGHOST_FOR_MIGRATION=postgres
PGPORT_FOR_MIGRATION=5432
# TCP probe budget: PG_WAIT_ATTEMPTS x PG_WAIT_INTERVAL seconds (~60 x 2s = 120s)
PG_WAIT_ATTEMPTS=60
PG_WAIT_INTERVAL=2
