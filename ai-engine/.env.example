# --- Environment ---
APP_ENV=dev
APP_NAME=ai-engine
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
SERVICE_API_KEY=change-me-service-key
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidataplatform
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# OpenRouter-compatible (set LLM_PROVIDER=openrouter to use)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OpenAI-compatible alias
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Storage / Models ---
STORAGE_PATH=./datasets
MODEL_PATH=./models
UPLOAD_MAX_MB=200
CHUNK_ROWS=20000

# --- Quality gates ---
QUALITY_MIN_SCORE=0.6

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
