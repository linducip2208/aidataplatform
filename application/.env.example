APP_NAME=AIDataPlatform
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (Postgres + pgvector, shared with the FastAPI engine) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aidata
DB_USERNAME=aidata
DB_PASSWORD=

# --- Cache / session / queue (Redis) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Uploads land on the default disk; there is no separate `datasets` disk.
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI engine (FastAPI) ---
AI_ENGINE_URL=http://127.0.0.1:8001
SERVICE_API_KEY=
SERVICE_API_KEY_HEADER=X-Service-Key
AI_ENGINE_CONNECT_TIMEOUT=5
AI_ENGINE_TIMEOUT=60
AI_ENGINE_LLM_TIMEOUT=120
AI_ENGINE_UPLOAD_TIMEOUT=300

# --- Platform defaults ---
QUALITY_THRESHOLD=0.75
MAX_UPLOAD_MB=500

# Bearer tokens issued by POST /api/login expire after this many days.
API_TOKEN_TTL_DAYS=30
