# Exclusions for a build whose context is this directory.
#
# NOTE: docker-compose.yml and .github/workflows/docker.yml both build the
# laravel image with the REPO ROOT as context, because
# infrastructure/docker/laravel.Dockerfile COPYs `application/...`. Docker
# therefore reads the ROOT .dockerignore, not this file. It is kept for anyone
# building with `docker build .` from inside application/; the root file must
# carry the application/ entries too.
#
# The Laravel image installs its own dependencies (composer install in
# infrastructure/docker/laravel.Dockerfile), so host copies of vendor/ and
# node_modules/ must stay out of the context either way.
.git/
.gitignore
.github/
.idea/
.vscode/
.zed/

# Secrets
.env
.env.backup
.env.production
auth.json
Homestead.json
Homestead.yaml

# Dependencies (installed inside the image)
vendor/
node_modules/

# Vite build output (rebuilt by the image)
public/build/
public/hot
public/storage

# Runtime state
storage/*.key
storage/pail
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Test and tool caches
.phpunit.cache/
.phpunit.result.cache
.pint.cache
npm-debug.log
yarn-error.log

# Local database files
database/*.sqlite
database/*.sqlite-journal
