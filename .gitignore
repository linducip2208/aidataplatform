# Laravel + Python + Node + Docker + data

# --- Laravel ---
/application/vendor/
/application/node_modules/
/application/public/build/
/application/public/hot
/application/storage/*.key
/application/.env
/application/.env.backup
/application/.env.production
/application/.phpunit.result.cache
/application/.phpunit.cache/

# --- Python (ai-engine) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg-info/
dist/
build/

# --- Node ---
node_modules/
dist/
.next/
.nuxt/

# --- Docker ---
.docker/

# --- Models / datasets (large artifacts, never commit) ---
# NOTE: artifact dirs are anchored to the repo root (`/models/` etc.) so the
# rule never matches source dirs like `application/app/Models/` (Eloquent
# models must be committed; that mistake silently dropped six model files).
*.pt
*.bin
*.onnx
*.safetensors
*.pkl
*.joblib
*.parquet
*.csv.gz
/data/
/datasets/
/models/
/backups/
# Runtime artifact dirs below the root (uploads, trained artifacts, local DBs).
ai-engine/datasets/
ai-engine/models/
application/storage/app/datasets/
# Local SQLite databases (dev/test scratch files, never commit).
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# --- Native Windows service manager (dev-only runtime state) ---
dev/runtime/
dev/logs/
ai-engine/logs/
ai-engine/celerybeat-schedule
ai-engine/celerybeat-schedule-shm
ai-engine/celerybeat-schedule-wal

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Secrets ---
.env
*.pem
*.key
infrastructure/nginx/ssl/
!infrastructure/nginx/ssl/.gitkeep
grafana-data/
mysql-data/
